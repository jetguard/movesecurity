generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Usuario {
  id        Int      @id @default(autoincrement())
  nome      String
  email     String   @unique
  senha     String
  createdAt DateTime @default(now())
}

model Ocorrencia {
  id              Int      @id @default(autoincrement())
  numero          Int
  ano             Int
  codigo          String   @unique
  assunto         String
  status          String   @default("ABERTO")
  dataOcorrencia  DateTime
  createdAt       DateTime @default(now())

  envolvidos      EnvolvidoOcorrencia[]
}

model EnvolvidoOcorrencia {
  id             Int     @id @default(autoincrement())
  ocorrenciaId   Int
  nome           String
  tipoDocumento  String
  documento      String
  empresa        String?
  possuiVeiculo  Boolean @default(false)
  placa          String?
  reboque        String?
  relato         String

  ocorrencia     Ocorrencia @relation(fields: [ocorrenciaId], references: [id], onDelete: Cascade)
}