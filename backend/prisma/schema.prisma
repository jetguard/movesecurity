generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Usuario {
  id        Int      @id @default(autoincrement())
  nome      String
  email     String   @unique
  senha     String
  apelido   String?
  fotoPerfil String?
  re        String?
  setor     String?
  cargo     String?
  empresa   String?
  createdAt DateTime @default(now())
}

model Ocorrencia {
  id                Int      @id @default(autoincrement())
  numero            Int
  ano               Int
  codigo            String   @unique
  assunto           String
  local             String
  natureza          String
  subNatureza       String
  status            String   @default("ABERTO")
  dataOcorrencia    DateTime
  relatoSeguranca   String?
  createdAt         DateTime @default(now())

  envolvidos        EnvolvidoOcorrencia[]
  anexos            AnexoOcorrencia[]
}

model EnvolvidoOcorrencia {
  id                 Int     @id @default(autoincrement())
  ocorrenciaId       Int

  tipoEnvolvimento   String

  nome               String
  tipoDocumento      String
  documento          String
  empresa            String?
  possuiVeiculo      Boolean @default(false)
  placa              String?
  reboque            String?
  relato             String

  ocorrencia         Ocorrencia @relation(fields: [ocorrenciaId], references: [id], onDelete: Cascade)
}

model AnexoOcorrencia {
  id            Int      @id @default(autoincrement())
  ocorrenciaId  Int
  nomeOriginal  String
  nomeArquivo   String
  caminho       String
  tipo          String
  createdAt     DateTime @default(now())

  ocorrencia    Ocorrencia @relation(fields: [ocorrenciaId], references: [id], onDelete: Cascade)
}

model Evento {
  id              Int      @id @default(autoincrement())
  numero          Int
  ano             Int
  codigo          String   @unique
  assunto         String
  local           String
  natureza        String
  subNatureza     String
  status          String   @default("ABERTO")
  dataEvento      DateTime
  relatoSeguranca String?
  createdAt       DateTime @default(now())

  envolvidos      EnvolvidoEvento[]
  anexos          AnexoEvento[]
}

model EnvolvidoEvento {
  id               Int     @id @default(autoincrement())
  eventoId         Int

  tipoEnvolvimento String

  nome             String
  tipoDocumento    String
  documento        String
  empresa          String?
  possuiVeiculo    Boolean @default(false)
  placa            String?
  reboque          String?
  relato           String

  evento           Evento @relation(fields: [eventoId], references: [id], onDelete: Cascade)
}

model AnexoEvento {
  id           Int      @id @default(autoincrement())
  eventoId     Int
  nomeOriginal String
  nomeArquivo  String
  caminho      String
  tipo         String
  createdAt    DateTime @default(now())

  evento       Evento @relation(fields: [eventoId], references: [id], onDelete: Cascade)
}

model Investigacao {
  id        Int      @id @default(autoincrement())
  titulo    String
  descricao String
  status    String   @default("ABERTO")
  createdAt DateTime @default(now())
}

model Natureza {
  id            Int            @id @default(autoincrement())
  nome          String         @unique
  createdAt     DateTime       @default(now())

  subNaturezas  SubNatureza[]
}

model SubNatureza {
  id          Int      @id @default(autoincrement())
  naturezaId  Int
  nome        String
  createdAt   DateTime @default(now())

  natureza    Natureza @relation(fields: [naturezaId], references: [id], onDelete: Cascade)

  @@unique([naturezaId, nome])
}
