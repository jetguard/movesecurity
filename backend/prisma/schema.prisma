generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Usuario {
  id                 Int       @id @default(autoincrement())
  nome               String
  email              String    @unique
  senha              String
  apelido            String?
  fotoPerfil         String?
  re                 String?
  setor              String?
  cargo              String?
  empresa            String?
  unidade            String?
  unidadesPermitidas String?
  perfilAcesso       String    @default("USUARIO")
  statusUsuario      String    @default("ATIVO")
  deveAlterarSenha   Boolean   @default(true)
  senhaAlteradaEm    DateTime?
  ultimoAcesso       DateTime?
  createdAt          DateTime  @default(now())

  analisesOcorrenciaIniciadas  AnaliseOcorrencia[]            @relation("AnaliseOcorrenciaResponsavel")
  analisesOcorrenciaConcluidas AnaliseOcorrencia[]            @relation("AnaliseOcorrenciaConclusor")
  analisesEventoIniciadas      AnaliseEvento[]                @relation("AnaliseEventoResponsavel")
  analisesEventoConcluidas     AnaliseEvento[]                @relation("AnaliseEventoConclusor")
  investigacoesResponsavel     Investigacao[]
  logs                         LogAuditoria[]
  riscosResponsavel            AnaliseRisco[]                 @relation("RiscoResponsavel")
  riscosAcao                   AnaliseRisco[]                 @relation("RiscoResponsavelAcao")
  analisesEstrategicas         AnaliseEstrategica[]
  planosAcaoResponsavel        PlanoAcaoCorporativo[]         @relation("PlanoAcaoResponsavel")
  checklistsResponsavel        ChecklistInspecao[]
  camerasCadastradas           CameraMonitoramento[]          @relation("CameraCriador")
  cameraChecklists             CameraChecklistOperacional[]   @relation("CameraChecklistResponsavel")
  notificacoesLidas            NotificacaoLida[]
  mencoesRecebidas             Mencao[]                       @relation("MencaoUsuario")
  mencoesCriadas               Mencao[]                       @relation("MencaoAutor")
  comentarios                  ComentarioInterno[]
  anulacoesSolicitadas         SolicitacaoAnulacaoRelatorio[] @relation("AnulacaoSolicitante")
  anulacoesDecididas           SolicitacaoAnulacaoRelatorio[] @relation("AnulacaoAdministrador")
  acordosAnulacao              AcordoAnulacaoRelatorio[]      @relation("AcordoAnulacaoAnalista")
  planejamentoCardsCriados     PlanejamentoCard[]             @relation("PlanejamentoCriador")
  planejamentoCardsResponsavel PlanejamentoCard[]             @relation("PlanejamentoResponsavel")
  quadraContainersCriados      QuadraSegurancaContainer[]     @relation("QuadraContainerCriador")
  quadraContainersAtualizados  QuadraSegurancaContainer[]     @relation("QuadraContainerAtualizador")
  quadraAnexos                 QuadraSegurancaAnexo[]         @relation("QuadraAnexoUsuario")
  quadraHistorico              QuadraSegurancaHistorico[]     @relation("QuadraHistoricoUsuario")
  dispositivosAutorizados      DispositivoAutorizado[]
}

model Ocorrencia {
  id              Int       @id @default(autoincrement())
  numero          Int
  ano             Int
  codigo          String
  assunto         String
  local           String
  unidade         String    @default("GJA-T1")
  natureza        String
  subNatureza     String
  status          String    @default("ABERTO")
  dataOcorrencia  DateTime
  relatoSeguranca String?
  fluxoStatus     String    @default("Aguardando Revisao")
  revisadoPorId   Int?
  revisadoEm      DateTime?
  aprovadoPorId   Int?
  aprovadoEm      DateTime?
  motivoDevolucao String?
  createdAt       DateTime  @default(now())

  envolvidos   EnvolvidoOcorrencia[]
  anexos       AnexoOcorrencia[]
  analise      AnaliseOcorrencia?
  investigacao Investigacao?
  riscos       AnaliseRisco[]

  @@unique([codigo, unidade])
}

model EnvolvidoOcorrencia {
  id           Int @id @default(autoincrement())
  ocorrenciaId Int

  tipoEnvolvimento String

  nome          String
  tipoDocumento String
  documento     String
  empresa       String?
  possuiVeiculo Boolean @default(false)
  placa         String?
  reboque       String?
  relato        String

  ocorrencia Ocorrencia @relation(fields: [ocorrenciaId], references: [id], onDelete: Cascade)
}

model AnexoOcorrencia {
  id           Int      @id @default(autoincrement())
  ocorrenciaId Int
  nomeOriginal String
  nomeArquivo  String
  caminho      String
  tipo         String
  hashArquivo  String?
  createdAt    DateTime @default(now())

  ocorrencia Ocorrencia @relation(fields: [ocorrenciaId], references: [id], onDelete: Cascade)
}

model Evento {
  id              Int       @id @default(autoincrement())
  numero          Int
  ano             Int
  codigo          String
  assunto         String
  local           String
  unidade         String    @default("GJA-T1")
  natureza        String
  subNatureza     String
  status          String    @default("ABERTO")
  dataEvento      DateTime
  relatoSeguranca String?
  fluxoStatus     String    @default("Aguardando Revisao")
  revisadoPorId   Int?
  revisadoEm      DateTime?
  aprovadoPorId   Int?
  aprovadoEm      DateTime?
  motivoDevolucao String?
  createdAt       DateTime  @default(now())

  envolvidos EnvolvidoEvento[]
  anexos     AnexoEvento[]
  analise    AnaliseEvento?
  riscos     AnaliseRisco[]

  @@unique([codigo, unidade])
}

model EnvolvidoEvento {
  id       Int @id @default(autoincrement())
  eventoId Int

  tipoEnvolvimento String

  nome          String
  tipoDocumento String
  documento     String
  empresa       String?
  possuiVeiculo Boolean @default(false)
  placa         String?
  reboque       String?
  relato        String

  evento Evento @relation(fields: [eventoId], references: [id], onDelete: Cascade)
}

model AnexoEvento {
  id           Int      @id @default(autoincrement())
  eventoId     Int
  nomeOriginal String
  nomeArquivo  String
  caminho      String
  tipo         String
  hashArquivo  String?
  createdAt    DateTime @default(now())

  evento Evento @relation(fields: [eventoId], references: [id], onDelete: Cascade)
}

model Investigacao {
  id                    Int       @id @default(autoincrement())
  ocorrenciaId          Int       @unique
  titulo                String
  descricao             String
  status                String    @default("Em Análise")
  numeroOcorrencia      String
  assunto               String
  local                 String
  unidade               String    @default("GJA-T1")
  natureza              String
  subNatureza           String
  dataOcorrencia        DateTime
  relatoSeguranca       String?
  fluxoStatus           String    @default("Aguardando Revisao")
  revisadoPorId         Int?
  revisadoEm            DateTime?
  aprovadoPorId         Int?
  aprovadoEm            DateTime?
  motivoDevolucao       String?
  descricaoInvestigacao String?
  conclusaoFatos        String?
  responsavelId         Int?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  ocorrencia  Ocorrencia     @relation(fields: [ocorrenciaId], references: [id], onDelete: Cascade)
  responsavel Usuario?       @relation(fields: [responsavelId], references: [id])
  riscos      AnaliseRisco[]
}

model Natureza {
  id        Int      @id @default(autoincrement())
  nome      String   @unique
  createdAt DateTime @default(now())

  subNaturezas SubNatureza[]
}

model SubNatureza {
  id         Int      @id @default(autoincrement())
  naturezaId Int
  nome       String
  createdAt  DateTime @default(now())

  natureza Natureza @relation(fields: [naturezaId], references: [id], onDelete: Cascade)

  @@unique([naturezaId, nome])
}

model LocalTerminal {
  id           Int      @id @default(autoincrement())
  nome         String
  descricao    String?
  tipo         String
  areaSensivel Boolean  @default(false)
  status       String   @default("Ativo")
  unidade      String   @default("GJA-T1")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([nome, unidade])
  @@index([unidade, status])
}

model QuadraSegurancaContainer {
  id                   Int       @id @default(autoincrement())
  numeroContainer      String
  unidade              String    @default("GJA-T1")
  dataHoraEntrada      DateTime
  dataHoraSaida        DateTime?
  tipoContainer        String
  dimensao             String
  destino              String
  scannerEntrada       Boolean   @default(false)
  scannerSaida         Boolean?
  estufadoTerminal     Boolean   @default(false)
  numeroLacre          String?
  novoLacre            String?
  armador              String?
  transportadora       String?
  motoristaResponsavel String?
  documentoMotorista   String?
  placaCavalo          String?
  placaCarreta         String?
  tipoCarga            String?
  pesoCarga            String?
  prioridade           String    @default("Baixa")
  statusOperacional    String    @default("Dentro do terminal")
  statusFinal          String?
  observacoes          String?
  observacoesSaida     String?
  criadoPorId          Int?
  atualizadoPorId      Int?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  criadoPor     Usuario?                   @relation("QuadraContainerCriador", fields: [criadoPorId], references: [id])
  atualizadoPor Usuario?                   @relation("QuadraContainerAtualizador", fields: [atualizadoPorId], references: [id])
  anexos        QuadraSegurancaAnexo[]
  historico     QuadraSegurancaHistorico[]

  @@unique([numeroContainer, unidade])
  @@index([unidade, statusOperacional])
  @@index([unidade, prioridade])
}

model QuadraSegurancaAnexo {
  id           Int      @id @default(autoincrement())
  containerId  Int
  categoria    String
  nomeOriginal String
  nomeArquivo  String
  caminho      String
  tipo         String
  hashArquivo  String?
  usuarioId    Int?
  createdAt    DateTime @default(now())

  container QuadraSegurancaContainer @relation(fields: [containerId], references: [id], onDelete: Cascade)
  usuario   Usuario?                 @relation("QuadraAnexoUsuario", fields: [usuarioId], references: [id])
}

model DispositivoAutorizado {
  id             Int       @id @default(autoincrement())
  usuarioId      Int
  identificador  String
  navegador      String?
  sistema        String?
  ipCadastro     String?
  ipUltimoAcesso String?
  status         String    @default("Autorizado")
  primeiroAcesso DateTime  @default(now())
  ultimoAcesso   DateTime?
  resetadoEm     DateTime?
  resetadoPorId  Int?
  motivoReset    String?

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, identificador])
  @@index([usuarioId, status])
}

model QuadraSegurancaHistorico {
  id              Int      @id @default(autoincrement())
  containerId     Int
  usuarioId       Int?
  acao            String
  detalhes        String?
  dadosAnteriores String?
  dadosNovos      String?
  createdAt       DateTime @default(now())

  container QuadraSegurancaContainer @relation(fields: [containerId], references: [id], onDelete: Cascade)
  usuario   Usuario?                 @relation("QuadraHistoricoUsuario", fields: [usuarioId], references: [id])
}

model AnaliseOcorrencia {
  id                 Int       @id @default(autoincrement())
  ocorrenciaId       Int       @unique
  responsavelId      Int
  iniciadoEm         DateTime  @default(now())
  concluidoEm        DateTime?
  status             String    @default("Em Análise")
  prejuizoFinanceiro String    @default("0,00")
  conclusaoAnalise   String?
  concluidoPorId     Int?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  ocorrencia   Ocorrencia @relation(fields: [ocorrenciaId], references: [id], onDelete: Cascade)
  responsavel  Usuario    @relation("AnaliseOcorrenciaResponsavel", fields: [responsavelId], references: [id])
  concluidoPor Usuario?   @relation("AnaliseOcorrenciaConclusor", fields: [concluidoPorId], references: [id])
}

model AnaliseEvento {
  id               Int       @id @default(autoincrement())
  eventoId         Int       @unique
  responsavelId    Int
  iniciadoEm       DateTime  @default(now())
  concluidoEm      DateTime?
  status           String    @default("Em Análise")
  valorRecuperado  String    @default("0,00")
  conclusaoAnalise String?
  concluidoPorId   Int?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  evento       Evento   @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  responsavel  Usuario  @relation("AnaliseEventoResponsavel", fields: [responsavelId], references: [id])
  concluidoPor Usuario? @relation("AnaliseEventoConclusor", fields: [concluidoPorId], references: [id])
}

model LogAuditoria {
  id              Int      @id @default(autoincrement())
  usuarioId       Int?
  usuarioNome     String
  ip              String?
  acao            String
  tipoRegistro    String
  registroId      Int?
  dadosAnteriores String?
  dadosNovos      String?
  createdAt       DateTime @default(now())

  usuario Usuario? @relation(fields: [usuarioId], references: [id])
}

model AnaliseRisco {
  id                  Int      @id @default(autoincrement())
  numero              Int
  ano                 Int
  codigo              String
  dataHora            DateTime
  responsavelId       Int
  unidade             String
  setor               String
  local               String
  tipoRisco           String
  naturezaRisco       String
  descricaoRisco      String
  possivelImpacto     String
  probabilidade       String
  severidade          String
  nivelRisco          String
  medidasPreventivas  String
  planoAcao           String
  responsavelAcaoId   Int?
  responsavelAcaoNome String?
  prazo               DateTime
  status              String   @default("Pendente")
  ocorrenciaId        Int?
  eventoId            Int?
  investigacaoId      Int?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  responsavel     Usuario       @relation("RiscoResponsavel", fields: [responsavelId], references: [id])
  responsavelAcao Usuario?      @relation("RiscoResponsavelAcao", fields: [responsavelAcaoId], references: [id])
  ocorrencia      Ocorrencia?   @relation(fields: [ocorrenciaId], references: [id], onDelete: SetNull)
  evento          Evento?       @relation(fields: [eventoId], references: [id], onDelete: SetNull)
  investigacao    Investigacao? @relation(fields: [investigacaoId], references: [id], onDelete: SetNull)
  fotos           FotoRisco[]

  @@unique([codigo, unidade])
}

model FotoRisco {
  id             Int      @id @default(autoincrement())
  analiseRiscoId Int
  nomeOriginal   String
  nomeArquivo    String
  caminho        String
  tipo           String
  createdAt      DateTime @default(now())

  analiseRisco AnaliseRisco @relation(fields: [analiseRiscoId], references: [id], onDelete: Cascade)
}

model AnaliseEstrategica {
  id              Int       @id @default(autoincrement())
  numero          Int
  ano             Int
  codigo          String
  tipo            String
  titulo          String
  unidade         String
  setor           String?
  local           String?
  dataHora        DateTime  @default(now())
  responsavelId   Int
  status          String    @default("Aberta")
  descricao       String
  diagnostico     String?
  impacto         String?
  recomendacoes   String?
  planoAcao       String?
  responsavelAcao String?
  prazo           DateTime?
  ocorrenciaId    Int?
  eventoId        Int?
  investigacaoId  Int?
  analiseRiscoId  Int?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  responsavel Usuario @relation(fields: [responsavelId], references: [id])

  @@unique([codigo, unidade])
}

model PlanoAcaoCorporativo {
  id              Int       @id @default(autoincrement())
  numero          Int
  ano             Int
  codigo          String
  titulo          String
  unidade         String
  origemModulo    String?
  origemId        Int?
  prioridade      String    @default("Media")
  status          String    @default("Pendente")
  percentual      Int       @default(0)
  descricao       String
  acaoCorretiva   String?
  acaoPreventiva  String?
  responsavelId   Int?
  responsavelNome String?
  prazo           DateTime
  concluidoEm     DateTime?
  evidencia       String?
  comentarios     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  responsavel Usuario? @relation("PlanoAcaoResponsavel", fields: [responsavelId], references: [id])

  @@unique([codigo, unidade])
}

model ChecklistInspecao {
  id              Int      @id @default(autoincrement())
  numero          Int
  ano             Int
  codigo          String
  titulo          String
  unidade         String
  setor           String?
  local           String
  tipo            String
  dataHora        DateTime @default(now())
  responsavelId   Int
  status          String   @default("Aberto")
  pontuacao       Int      @default(0)
  observacoes     String?
  planoAcaoGerado Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  responsavel Usuario         @relation(fields: [responsavelId], references: [id])
  itens       ChecklistItem[]

  @@unique([codigo, unidade])
}

model ChecklistItem {
  id           Int      @id @default(autoincrement())
  checklistId  Int
  categoria    String
  descricao    String
  conformidade String   @default("Conforme")
  criticidade  String   @default("Media")
  observacao   String?
  createdAt    DateTime @default(now())

  checklist ChecklistInspecao @relation(fields: [checklistId], references: [id], onDelete: Cascade)
}

model Mencao {
  id                  Int       @id @default(autoincrement())
  modulo              String
  registroId          Int
  codigoRegistro      String
  tituloRegistro      String
  unidade             String
  usuarioMencionadoId Int
  autorId             Int?
  tipoMencao          String    @default("Acompanhar")
  status              String    @default("Pendente")
  prazo               DateTime?
  observacao          String?
  lidaEm              DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  usuarioMencionado Usuario  @relation("MencaoUsuario", fields: [usuarioMencionadoId], references: [id])
  autor             Usuario? @relation("MencaoAutor", fields: [autorId], references: [id])
}

model ComentarioInterno {
  id         Int      @id @default(autoincrement())
  modulo     String
  registroId Int
  unidade    String
  comentario String
  autorId    Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  autor Usuario @relation(fields: [autorId], references: [id])
}

model CameraMonitoramento {
  id                     Int       @id @default(autoincrement())
  numeroCamera           Int
  numeroServidor         Int
  tipoSistema            String    @default("DIGIFORT")
  periodoGravacaoDias    Int
  status                 String    @default("Conectada")
  tecnologia             String
  tipoCamera             String
  localInstalado         String
  areaMonitorada         String
  infravermelho          String
  monitoramento          String    @default("Ativo")
  ultimaManutencao       DateTime?
  observacoesTecnicas    String?
  unidade                String    @default("GJA-T1")
  cadastradoPorId        Int?
  desconectadaDesde      DateTime?
  totalIndisponibilidade Int       @default(0)
  totalFalhas            Int       @default(0)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  cadastradoPor Usuario?                     @relation("CameraCriador", fields: [cadastradoPorId], references: [id])
  checklists    CameraChecklistOperacional[]
  eventos       CameraEventoStatus[]

  @@unique([numeroCamera, unidade])
}

model CameraChecklistOperacional {
  id                         Int      @id @default(autoincrement())
  cameraId                   Int
  unidade                    String   @default("GJA-T1")
  responsavelId              Int
  statusAtual                String
  tempoGravacaoDisponivel    Int
  qualidadeImagem            String
  funcionamentoInfravermelho String
  funcionamentoGravacao      String
  comunicacaoServidor        String
  instabilidadeDetectada     String
  necessidadeManutencao      String
  observacoesOperacionais    String?
  indisponibilidadeMinutos   Int      @default(0)
  falhaRecorrente            Boolean  @default(false)
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  camera      CameraMonitoramento @relation(fields: [cameraId], references: [id], onDelete: Cascade)
  responsavel Usuario             @relation("CameraChecklistResponsavel", fields: [responsavelId], references: [id])
}

model CameraEventoStatus {
  id                  Int       @id @default(autoincrement())
  cameraId            Int
  unidade             String    @default("GJA-T1")
  statusAnterior      String?
  statusNovo          String
  iniciadoEm          DateTime  @default(now())
  encerradoEm         DateTime?
  duracaoIndisponivel Int?
  responsavelId       Int?
  observacao          String?
  createdAt           DateTime  @default(now())

  camera CameraMonitoramento @relation(fields: [cameraId], references: [id], onDelete: Cascade)
}

model ConfiguracaoSistema {
  id                  Int      @id @default(autoincrement())
  chave               String   @unique
  nomeEmpresa         String   @default("Movecta S/A")
  slaCameras          Int      @default(98)
  tempoMaximoOffline  Int      @default(60)
  checklistCameraDias Int      @default(7)
  corsPermitido       String?
  logoUrl             String?
  rodapePdf           String?
  updatedAt           DateTime @updatedAt
  createdAt           DateTime @default(now())
}

model NotificacaoLida {
  id            Int      @id @default(autoincrement())
  usuarioId     Int
  notificacaoId String
  lidaEm        DateTime @default(now())

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, notificacaoId])
}

model SolicitacaoAnulacaoRelatorio {
  id             Int       @id @default(autoincrement())
  modulo         String
  registroId     Int
  codigoRegistro String
  tituloRegistro String
  unidade        String
  motivo         String
  status         String    @default("Pendente")
  solicitanteId  Int
  decididoPorId  Int?
  decisaoMotivo  String?
  decididoEm     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  solicitante Usuario                   @relation("AnulacaoSolicitante", fields: [solicitanteId], references: [id])
  decididoPor Usuario?                  @relation("AnulacaoAdministrador", fields: [decididoPorId], references: [id])
  acordos     AcordoAnulacaoRelatorio[]

  @@index([modulo, registroId, status])
}

model AcordoAnulacaoRelatorio {
  id            Int       @id @default(autoincrement())
  solicitacaoId Int
  analistaId    Int
  status        String    @default("Pendente")
  observacao    String?
  decididoEm    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  solicitacao SolicitacaoAnulacaoRelatorio @relation(fields: [solicitacaoId], references: [id], onDelete: Cascade)
  analista    Usuario                      @relation("AcordoAnulacaoAnalista", fields: [analistaId], references: [id])

  @@unique([solicitacaoId, analistaId])
}

model PlanejamentoColuna {
  id        Int      @id @default(autoincrement())
  titulo    String
  unidade   String
  ordem     Int      @default(0)
  cor       String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cards PlanejamentoCard[]

  @@index([unidade, ordem])
}

model PlanejamentoCard {
  id              Int       @id @default(autoincrement())
  titulo          String
  descricao       String?
  prioridade      String    @default("Media")
  prazo           DateTime?
  unidade         String
  setor           String?
  local           String?
  moduloVinculado String?
  registroId      Int?
  codigoRegistro  String?
  ordem           Int       @default(0)
  status          String    @default("Ativo")
  colunaId        Int
  responsavelId   Int?
  criadoPorId     Int
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  coluna      PlanejamentoColuna @relation(fields: [colunaId], references: [id], onDelete: Cascade)
  responsavel Usuario?           @relation("PlanejamentoResponsavel", fields: [responsavelId], references: [id])
  criadoPor   Usuario            @relation("PlanejamentoCriador", fields: [criadoPorId], references: [id])

  @@index([unidade, colunaId, ordem])
  @@index([responsavelId])
}
