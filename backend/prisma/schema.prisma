generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Usuario {
  id        Int      @id @default(autoincrement())
  nome      String
  email     String   @unique
  senha     String
  createdAt DateTime @default(now())
}

model Ocorrencia {
  id                Int      @id @default(autoincrement())
  numero            Int
  ano               Int
  codigo            String   @unique
  assunto           String
  local             String
  natureza          String
  subNatureza       String
  status            String   @default("ABERTO")
  dataOcorrencia    DateTime
  relatoSeguranca   String?
  createdAt         DateTime @default(now())

  envolvidos        EnvolvidoOcorrencia[]
  anexos            AnexoOcorrencia[]
}

model EnvolvidoOcorrencia {
  id                 Int     @id @default(autoincrement())
  ocorrenciaId       Int

  tipoEnvolvimento   String

  nome               String
  tipoDocumento      String
  documento          String
  empresa            String?
  possuiVeiculo      Boolean @default(false)
  placa              String?
  reboque            String?
  relato             String

  ocorrencia         Ocorrencia @relation(fields: [ocorrenciaId], references: [id], onDelete: Cascade)
}

model AnexoOcorrencia {
  id            Int      @id @default(autoincrement())
  ocorrenciaId  Int
  nomeOriginal  String
  nomeArquivo   String
  caminho       String
  tipo          String
  createdAt     DateTime @default(now())

  ocorrencia    Ocorrencia @relation(fields: [ocorrenciaId], references: [id], onDelete: Cascade)
}

model Evento {
  id          Int      @id @default(autoincrement())
  numero      Int
  ano         Int
  codigo      String   @unique
  assunto     String
  status      String   @default("ABERTO")
  dataEvento  DateTime
  createdAt   DateTime @default(now())

  envolvidos  EnvolvidoEvento[]
}

model EnvolvidoEvento {
  id             Int     @id @default(autoincrement())
  eventoId       Int
  nome           String
  tipoDocumento  String
  documento      String
  empresa        String?
  possuiVeiculo  Boolean @default(false)
  placa          String?
  reboque        String?
  relato         String

  evento         Evento @relation(fields: [eventoId], references: [id], onDelete: Cascade)
}