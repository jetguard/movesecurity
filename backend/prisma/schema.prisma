generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


model Usuario {
  id                         Int       @id @default(autoincrement())
  nome                       String
  email                      String    @unique
  cpf                        String?   @unique
  senha                      String
  apelido                    String?
  fotoPerfil                 String?
  re                         String?
  setor                      String?
  cargo                      String?
  empresa                    String?
  terceirizado               Boolean   @default(false)
  equipe                     String?
  unidade                    String?
  unidadesPermitidas         String?
  perfilAcesso               String    @default("USUARIO")
  validadorOperacional       Boolean   @default(false)
  mediadorOperacional        Boolean   @default(false)
  statusUsuario              String    @default("ATIVO")
  deveAlterarSenha           Boolean   @default(true)
  bloqueioAutomaticoSessao   Boolean   @default(true)
  somenteCadastro            Boolean   @default(false)
  gruposTreinamentoJson      String    @default("[]")
  senhaAlteradaEm            DateTime?
  pinOperacionalHash         String?
  pinOperacionalCriadoEm     DateTime?
  pinOperacionalAtualizadoEm DateTime?
  pinTentativasInvalidas     Int       @default(0)
  pinBloqueadoAte            DateTime?
  doisFatoresAtivo           Boolean   @default(false)
  doisFatoresMetodo          String?   @default("EMAIL")
  doisFatoresCodigoHash      String?
  doisFatoresExpiraEm        DateTime?
  doisFatoresTentativas      Int       @default(0)
  doisFatoresTotpSecret      String?
  doisFatoresTotpConfirmadoEm DateTime?
  ultimoAcesso               DateTime?
  createdAt                  DateTime  @default(now())

  analisesOcorrenciaIniciadas  AnaliseOcorrencia[]            @relation("AnaliseOcorrenciaResponsavel")
  analisesOcorrenciaConcluidas AnaliseOcorrencia[]            @relation("AnaliseOcorrenciaConclusor")
  analisesEventoIniciadas      AnaliseEvento[]                @relation("AnaliseEventoResponsavel")
  analisesEventoConcluidas     AnaliseEvento[]                @relation("AnaliseEventoConclusor")
  investigacoesResponsavel     Investigacao[]
  logs                         LogAuditoria[]
  riscosResponsavel            AnaliseRisco[]                 @relation("RiscoResponsavel")
  riscosAcao                   AnaliseRisco[]                 @relation("RiscoResponsavelAcao")
  analisesEstrategicas         AnaliseEstrategica[]
  planosAcaoResponsavel        PlanoAcaoCorporativo[]         @relation("PlanoAcaoResponsavel")
  checklistsResponsavel        ChecklistInspecao[]
  camerasCadastradas           CameraMonitoramento[]          @relation("CameraCriador")
  cameraChecklists             CameraChecklistOperacional[]   @relation("CameraChecklistResponsavel")
  ordensServicoAbertas         OrdemServicoCamera[]           @relation("OrdemServicoAbertaPor")
  ordensServicoAtendidas       OrdemServicoCamera[]           @relation("OrdemServicoAtendidaPor")
  notificacoesLidas            NotificacaoLida[]
  mencoesRecebidas             Mencao[]                       @relation("MencaoUsuario")
  mencoesCriadas               Mencao[]                       @relation("MencaoAutor")
  comentarios                  ComentarioInterno[]
  anulacoesSolicitadas         SolicitacaoAnulacaoRelatorio[] @relation("AnulacaoSolicitante")
  anulacoesDecididas           SolicitacaoAnulacaoRelatorio[] @relation("AnulacaoAdministrador")
  acordosAnulacao              AcordoAnulacaoRelatorio[]      @relation("AcordoAnulacaoAnalista")
  planejamentoCardsCriados     PlanejamentoCard[]             @relation("PlanejamentoCriador")
  planejamentoCardsResponsavel PlanejamentoCard[]             @relation("PlanejamentoResponsavel")
  passagensTurnoResponsavel    PassagemTurno[]                @relation("PassagemTurnoResponsavel")
  relatoriosDiariosResponsavel RelatorioDiarioExecutivo[]     @relation("RelatorioDiarioResponsavel")
  operacaoIndicadoresCriados   OperacaoIndicadorRegistro[]    @relation("OperacaoIndicadorCriador")
  operacaoIndicadoresValidados OperacaoIndicadorRegistro[]    @relation("OperacaoIndicadorValidador")
  scannerPassagensCriadas      ScannerPassagem[]              @relation("ScannerPassagemCriador")
  scannerPassagensValidadas    ScannerPassagem[]              @relation("ScannerPassagemValidador")
  quadraContainersCriados      QuadraSegurancaContainer[]     @relation("QuadraContainerCriador")
  quadraContainersAtualizados  QuadraSegurancaContainer[]     @relation("QuadraContainerAtualizador")
  quadraAnexos                 QuadraSegurancaAnexo[]         @relation("QuadraAnexoUsuario")
  quadraHistorico              QuadraSegurancaHistorico[]     @relation("QuadraHistoricoUsuario")
  dispositivosAutorizados      DispositivoAutorizado[]
  sessoes                      SessaoUsuario[]
  sugestoesMelhoria            SugestaoMelhoria[]             @relation("SugestaoMelhoriaAutor")
  sugestoesMelhoriaAvaliadas   SugestaoMelhoria[]             @relation("SugestaoMelhoriaAvaliador")
  assinaturasDocumentos        AssinaturaDocumento[]
  rascunhosFormulario          RascunhoFormulario[]
  relatoriosCftvEmitidos       RelatorioCftv[]                @relation("RelatorioCftvResponsavel")
  solicitacoesImagemCriadas     SolicitacaoImagem[]           @relation("SolicitacaoImagemCriadaPor")
  solicitacoesImagemAtendidas   SolicitacaoImagem[]           @relation("SolicitacaoImagemAtendente")
  solicitacoesImagemConcluidas  SolicitacaoImagem[]           @relation("SolicitacaoImagemConcluidaPor")
  solicitacoesImagemAnuladas    SolicitacaoImagem[]           @relation("SolicitacaoImagemAnuladaPor")
  solicitacoesImagemExcluidas   SolicitacaoImagem[]           @relation("SolicitacaoImagemExcluidaPor")
  atendimentosImagem            AtendimentoSolicitacaoImagem[] @relation("AtendimentoSolicitacaoImagemAtendente")
  historicosSolicitacaoImagem   HistoricoSolicitacaoImagem[]  @relation("HistoricoSolicitacaoImagemUsuario")
  anexosSolicitacaoImagem       AnexoSolicitacaoImagem[]      @relation("AnexoSolicitacaoImagemUsuario")
  tokensSolicitacaoImagem       TokenSolicitacaoImagem[]      @relation("TokenSolicitacaoImagemCriadoPor")
  relatosCampoGerados          RelatoCampo[]
}

model PerfilAcesso {
  id             Int      @id @default(autoincrement())
  codigo         String   @unique
  nome           String
  descricao      String?
  permissoesJson String   @default("[]")
  sistema        Boolean  @default(false)
  status         String   @default("ATIVO")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([status, nome])
}

model TreinamentoTerminal {
  id                 Int       @id @default(autoincrement())
  token              String    @unique
  codigo             String?   @unique
  nomeCompleto       String
  cpf                String
  dataNascimento     DateTime
  empresa            String
  cargo              String
  email              String
  telefone           String
  etapa              String    @default("video")
  status             String    @default("Em andamento")
  videoUrl           String?
  progressoSegundos  Int       @default(0)
  duracaoSegundos    Int       @default(0)
  videoConcluido     Boolean   @default(false)
  aceiteDeclaracao   Boolean   @default(false)
  assinaturaDataUrl  String?
  certificadoArquivo String?
  emailStatus        String?
  emailEnviadoEm     DateTime?
  concluidoEm        DateTime?
  ultimoAcessoEm     DateTime  @default(now())
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([cpf])
  @@index([status, updatedAt])
}

model IntegracaoTerminal {
  id                 Int       @id @default(autoincrement())
  token              String    @unique
  codigo             String?   @unique
  nomeCompleto       String
  cpf                String
  dataNascimento     DateTime
  empresa            String
  cargo              String
  email              String
  telefone           String
  etapa              String    @default("video")
  status             String    @default("Em andamento")
  videoUrl           String?
  progressoSegundos  Int       @default(0)
  duracaoSegundos    Int       @default(0)
  videoConcluido     Boolean   @default(false)
  quizAprovado       Boolean   @default(false)
  respostasQuiz      String?
  aceiteDeclaracao   Boolean   @default(false)
  assinaturaDataUrl  String?
  certificadoArquivo String?
  emailStatus        String?
  emailEnviadoEm     DateTime?
  concluidoEm        DateTime?
  ultimoAcessoEm     DateTime  @default(now())
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([cpf])
  @@index([status, updatedAt])
}

model TreinamentoPocSep007 {
  id                 Int       @id @default(autoincrement())
  token              String    @unique
  usuarioId          Int?
  codigo             String?   @unique
  nomeCompleto       String
  cpf                String?
  email              String
  cargo              String?
  departamento       String?
  unidade            String?
  empresa            String?
  etapaAtual         Int       @default(1)
  status             String    @default("Em andamento")
  porcentagem        Int       @default(0)
  nota               Float?
  tentativas         Int       @default(0)
  respostasQuiz      String?
  assinaturaDataUrl  String?
  certificadoArquivo String?
  emailStatus        String?
  emailEnviadoEm     DateTime?
  ipInicio           String?
  navegador          String?
  sistema            String?
  dataInicio         DateTime  @default(now())
  dataConclusao      DateTime?
  ultimoAcessoEm     DateTime  @default(now())
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([email])
  @@index([cpf])
  @@index([status, updatedAt])
}

model TreinamentoPocSep001 {
  id                 Int       @id @default(autoincrement())
  token              String    @unique
  usuarioId          Int?
  codigo             String?   @unique
  nomeCompleto       String
  cpf                String?
  email              String
  cargo              String?
  departamento       String?
  unidade            String?
  empresa            String?
  etapaAtual         Int       @default(1)
  status             String    @default("Em andamento")
  porcentagem        Int       @default(0)
  nota               Float?
  tentativas         Int       @default(0)
  respostasQuiz      String?
  assinaturaDataUrl  String?
  certificadoArquivo String?
  emailStatus        String?
  emailEnviadoEm     DateTime?
  ipInicio           String?
  navegador          String?
  sistema            String?
  dataInicio         DateTime  @default(now())
  dataConclusao      DateTime?
  ultimoAcessoEm     DateTime  @default(now())
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([email])
  @@index([cpf])
  @@index([status, updatedAt])
}

model SessaoUsuario {
  id                 String    @id @default(cuid())
  usuarioId          Int
  tokenHash          String?   @unique
  refreshTokenHash   String?   @unique
  refreshExpiraEm    DateTime?
  status             String    @default("ATIVA")
  unidadeAtiva       String?
  equipe             String?
  perfilAcesso       String?
  ipInicio           String?
  ipUltimaAtividade  String?
  navegador          String?
  sistema            String?
  iniciadaEm         DateTime  @default(now())
  ultimaAtividadeEm  DateTime  @default(now())
  encerradaEm        DateTime?
  encerradaPor       String?
  encerradaPorId     Int?
  motivoEncerramento String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId, status])
  @@index([status, ultimaAtividadeEm])
}

model SugestaoMelhoria {
  id            Int       @id @default(autoincrement())
  assunto       String
  sugestao      String
  printTela     String?
  nomeArquivo   String?
  status        String    @default("Recebida")
  resposta      String?
  unidade       String    @default("GJA-T1")
  autorId       Int
  avaliadoPorId Int?
  avaliadoEm    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  autor       Usuario  @relation("SugestaoMelhoriaAutor", fields: [autorId], references: [id], onDelete: Cascade)
  avaliadoPor Usuario? @relation("SugestaoMelhoriaAvaliador", fields: [avaliadoPorId], references: [id])

  @@index([status, unidade])
  @@index([autorId, createdAt])
}

model Ocorrencia {
  id                 Int       @id @default(autoincrement())
  numero             Int
  ano                Int
  codigo             String
  assunto            String
  local              String
  unidade            String    @default("GJA-T1")
  natureza           String
  subNatureza        String
  status             String    @default("ABERTO")
  dataOcorrencia     DateTime
  relatoSeguranca    String?
  acoesTomadas       String?
  impactoOperacional String?
  fluxoStatus        String    @default("Aguardando Revisao")
  revisadoPorId      Int?
  revisadoEm         DateTime?
  aprovadoPorId      Int?
  aprovadoEm         DateTime?
  motivoDevolucao    String?
  createdAt          DateTime  @default(now())

  envolvidos   EnvolvidoOcorrencia[]
  anexos       AnexoOcorrencia[]
  analise      AnaliseOcorrencia?
  investigacao Investigacao?
  riscos       AnaliseRisco[]

  @@unique([codigo, unidade])
}

model EnvolvidoOcorrencia {
  id           Int @id @default(autoincrement())
  ocorrenciaId Int

  tipoEnvolvimento String

  nome          String
  tipoDocumento String
  documento     String
  empresa       String?
  possuiVeiculo Boolean @default(false)
  placa         String?
  reboque       String?
  relato        String

  ocorrencia Ocorrencia @relation(fields: [ocorrenciaId], references: [id], onDelete: Cascade)
}

model AnexoOcorrencia {
  id           Int      @id @default(autoincrement())
  ocorrenciaId Int
  nomeOriginal String
  nomeArquivo  String
  caminho      String
  tipo         String
  hashArquivo  String?
  createdAt    DateTime @default(now())

  ocorrencia Ocorrencia @relation(fields: [ocorrenciaId], references: [id], onDelete: Cascade)
}

model Evento {
  id                 Int       @id @default(autoincrement())
  numero             Int
  ano                Int
  codigo             String
  assunto            String
  local              String
  unidade            String    @default("GJA-T1")
  natureza           String
  subNatureza        String
  status             String    @default("ABERTO")
  dataEvento         DateTime
  relatoSeguranca    String?
  acoesTomadas       String?
  impactoOperacional String?
  fluxoStatus        String    @default("Aguardando Revisao")
  revisadoPorId      Int?
  revisadoEm         DateTime?
  aprovadoPorId      Int?
  aprovadoEm         DateTime?
  motivoDevolucao    String?
  createdAt          DateTime  @default(now())

  envolvidos EnvolvidoEvento[]
  anexos     AnexoEvento[]
  analise    AnaliseEvento?
  riscos     AnaliseRisco[]

  @@unique([codigo, unidade])
}

model EnvolvidoEvento {
  id       Int @id @default(autoincrement())
  eventoId Int

  tipoEnvolvimento String

  nome          String
  tipoDocumento String
  documento     String
  empresa       String?
  possuiVeiculo Boolean @default(false)
  placa         String?
  reboque       String?
  relato        String

  evento Evento @relation(fields: [eventoId], references: [id], onDelete: Cascade)
}

model AnexoEvento {
  id           Int      @id @default(autoincrement())
  eventoId     Int
  nomeOriginal String
  nomeArquivo  String
  caminho      String
  tipo         String
  hashArquivo  String?
  createdAt    DateTime @default(now())

  evento Evento @relation(fields: [eventoId], references: [id], onDelete: Cascade)
}

model RelatoCampo {
  id                   Int       @id @default(autoincrement())
  token                String    @unique
  status               String    @default("Link Gerado")
  titulo               String?
  setor                String?
  local                String?
  unidade              String    @default("GJA-T1")
  responsavelColeta    String?
  dataOcorrido         DateTime?
  observacoes          String?
  checklistColeta      String?
  expiraEm             DateTime
  enviadoEm            DateTime?
  finalizadoEm         DateTime?
  convertidoTipo       String?
  convertidoRegistroId Int?
  convertidoCodigo     String?
  geradoPorId          Int?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  geradoPor  Usuario?               @relation(fields: [geradoPorId], references: [id])
  envolvidos EnvolvidoRelatoCampo[]
  anexos     AnexoRelatoCampo[]

  @@index([status, unidade])
  @@index([token, expiraEm])
}

model EnvolvidoRelatoCampo {
  id            Int @id @default(autoincrement())
  relatoCampoId Int

  tipoEnvolvimento String
  nome             String
  tipoDocumento    String
  documento        String?
  empresa          String?
  possuiVeiculo    Boolean  @default(false)
  placa            String?
  reboque          String?
  relato           String
  audioCaminho     String?
  audioNome        String?
  audioTipo        String?
  createdAt        DateTime @default(now())

  relatoCampo RelatoCampo @relation(fields: [relatoCampoId], references: [id], onDelete: Cascade)
}

model AnexoRelatoCampo {
  id            Int      @id @default(autoincrement())
  relatoCampoId Int
  nomeOriginal  String
  nomeArquivo   String
  caminho       String
  tipo          String
  categoria     String   @default("Evidencia")
  hashArquivo   String?
  createdAt     DateTime @default(now())

  relatoCampo RelatoCampo @relation(fields: [relatoCampoId], references: [id], onDelete: Cascade)
}

model Investigacao {
  id                    Int       @id @default(autoincrement())
  ocorrenciaId          Int       @unique
  numero                Int?
  ano                   Int?
  codigo                String?
  titulo                String
  descricao             String
  status                String    @default("Em Análise")
  numeroOcorrencia      String
  assunto               String
  local                 String
  unidade               String    @default("GJA-T1")
  natureza              String
  subNatureza           String
  dataOcorrencia        DateTime
  relatoSeguranca       String?
  fluxoStatus           String    @default("Aguardando Revisao")
  revisadoPorId         Int?
  revisadoEm            DateTime?
  aprovadoPorId         Int?
  aprovadoEm            DateTime?
  motivoDevolucao       String?
  descricaoInvestigacao String?
  conclusaoFatos        String?
  responsavelId         Int?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  ocorrencia  Ocorrencia     @relation(fields: [ocorrenciaId], references: [id], onDelete: Cascade)
  responsavel Usuario?       @relation(fields: [responsavelId], references: [id])
  riscos      AnaliseRisco[]

  @@unique([codigo, unidade])
}

model Natureza {
  id        Int      @id @default(autoincrement())
  nome      String   @unique
  createdAt DateTime @default(now())

  subNaturezas SubNatureza[]
}

model SubNatureza {
  id         Int      @id @default(autoincrement())
  naturezaId Int
  nome       String
  createdAt  DateTime @default(now())

  natureza Natureza @relation(fields: [naturezaId], references: [id], onDelete: Cascade)

  @@unique([naturezaId, nome])
}

model LocalTerminal {
  id           Int      @id @default(autoincrement())
  nome         String
  descricao    String?
  tipo         String
  areaSensivel Boolean  @default(false)
  status       String   @default("Ativo")
  unidade      String   @default("GJA-T1")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([nome, unidade])
  @@index([unidade, status])
}

model QuadraSegurancaContainer {
  id                   Int       @id @default(autoincrement())
  numeroContainer      String
  unidade              String    @default("GJA-T1")
  dataHoraEntrada      DateTime
  dataHoraSaida        DateTime?
  posicionamento       String?
  tipoContainer        String
  dimensao             String
  destino              String
  scannerEntrada       Boolean   @default(false)
  scannerSaida         Boolean?
  estufadoTerminal     Boolean   @default(false)
  numeroLacre          String?
  novoLacre            String?
  armador              String?
  transportadora       String?
  motoristaResponsavel String?
  documentoMotorista   String?
  placaCavalo          String?
  placaCarreta         String?
  tipoCarga            String?
  pesoCarga            String?
  prioridade           String    @default("Baixa")
  statusOperacional    String    @default("Dentro do terminal")
  statusFinal          String?
  observacoes          String?
  observacoesSaida     String?
  criadoPorId          Int?
  atualizadoPorId      Int?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  criadoPor     Usuario?                   @relation("QuadraContainerCriador", fields: [criadoPorId], references: [id])
  atualizadoPor Usuario?                   @relation("QuadraContainerAtualizador", fields: [atualizadoPorId], references: [id])
  anexos        QuadraSegurancaAnexo[]
  historico     QuadraSegurancaHistorico[]

  @@unique([numeroContainer, unidade])
  @@index([unidade, statusOperacional])
  @@index([unidade, prioridade])
}

model QuadraSegurancaAnexo {
  id           Int      @id @default(autoincrement())
  containerId  Int
  categoria    String
  nomeOriginal String
  nomeArquivo  String
  caminho      String
  tipo         String
  hashArquivo  String?
  usuarioId    Int?
  createdAt    DateTime @default(now())

  container QuadraSegurancaContainer @relation(fields: [containerId], references: [id], onDelete: Cascade)
  usuario   Usuario?                 @relation("QuadraAnexoUsuario", fields: [usuarioId], references: [id])
}

model DispositivoAutorizado {
  id             Int       @id @default(autoincrement())
  usuarioId      Int
  identificador  String
  navegador      String?
  sistema        String?
  ipCadastro     String?
  ipUltimoAcesso String?
  status         String    @default("Autorizado")
  primeiroAcesso DateTime  @default(now())
  ultimoAcesso   DateTime?
  resetadoEm     DateTime?
  resetadoPorId  Int?
  motivoReset    String?

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, identificador])
  @@index([usuarioId, status])
}

model QuadraSegurancaHistorico {
  id              Int      @id @default(autoincrement())
  containerId     Int
  usuarioId       Int?
  acao            String
  detalhes        String?
  dadosAnteriores String?
  dadosNovos      String?
  createdAt       DateTime @default(now())

  container QuadraSegurancaContainer @relation(fields: [containerId], references: [id], onDelete: Cascade)
  usuario   Usuario?                 @relation("QuadraHistoricoUsuario", fields: [usuarioId], references: [id])
}

model AnaliseOcorrencia {
  id                 Int       @id @default(autoincrement())
  ocorrenciaId       Int       @unique
  responsavelId      Int
  iniciadoEm         DateTime  @default(now())
  concluidoEm        DateTime?
  status             String    @default("Em Análise")
  prejuizoFinanceiro String    @default("0,00")
  houveDanoPrejuizo  String?
  tipoImpactoFinanceiro String?
  valorPrejuizo      String    @default("0,00")
  valorRecuperado    String    @default("0,00")
  conclusaoAnalise   String?
  concluidoPorId     Int?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  ocorrencia   Ocorrencia @relation(fields: [ocorrenciaId], references: [id], onDelete: Cascade)
  responsavel  Usuario    @relation("AnaliseOcorrenciaResponsavel", fields: [responsavelId], references: [id])
  concluidoPor Usuario?   @relation("AnaliseOcorrenciaConclusor", fields: [concluidoPorId], references: [id])
}

model AnaliseEvento {
  id               Int       @id @default(autoincrement())
  eventoId         Int       @unique
  responsavelId    Int
  iniciadoEm       DateTime  @default(now())
  concluidoEm      DateTime?
  status           String    @default("Em Análise")
  valorRecuperado  String    @default("0,00")
  houveDanoPrejuizo  String?
  tipoImpactoFinanceiro String?
  valorPrejuizo      String    @default("0,00")
  conclusaoAnalise String?
  concluidoPorId   Int?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

